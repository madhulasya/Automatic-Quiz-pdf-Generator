});

app.get('/api/test-db', async (req, res) => {
    try {
        if (!pool) {
            return res.status(500).json({ 
                success: false, 
                error: 'Database not connected' 
            });
        }
        
        const [result] = await pool.query('SELECT 1 as test');
        res.json({ 
            success: true, 
            message: 'Database connected!',
            result: result[0]
        });
    } catch (error) {
        res.status(500).json({ 
            success: false, 
            error: error.message 
        });
    }
});

