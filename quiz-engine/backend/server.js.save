// Get user's quiz attempts
app.get('/api/user/attempts', authenticateToken, async (req, res) => {
    try {
        const [attempts] = await pool.query(`
            SELECT qa.*, q.title as quiz_title, q.passing_score
            FROM quiz_attempts qa
            JOIN quizzes q ON qa.quiz_id = q.id
            WHERE qa.user_id = ?
            ORDER BY qa.attempted_at DESC
        `, [req.user.id]);
        
        res.json(attempts);
    } catch (error) {
        console.error('Error fetching attempts:', error);
        res.status(500).json({ error: 'Server error' });
    }
});

// Admin: Get all quizzes with stats
app.get('/api/admin/quizzes', authenticateToken, async (req, res) => {
    try {
        if (req.user.role !== 'admin') {
            return res.status(403).json({ error: 'Admin access required' });
        }
        
        const [quizzes] = await pool.query(`
            SELECT q.*, 
                   COUNT(DISTINCT qa.id) as total_attempts,
                   AVG(qa.percentage) as avg_score
            FROM quizzes q
            LEFT JOIN quiz_attempts qa ON q.id = qa.quiz_id
            GROUP BY q.id
            ORDER BY q.created_at DESC
        `);
        
        res.json(quizzes);
    } catch (error) {
        console.error('Error fetching admin quizzes:', error);
        res.status(500).json({ error: 'Server error' });
    }
});

// Admin: Delete quiz
app.delete('/api/admin/quiz/:id', authenticateToken, async (req, res) => {
    try {
        if (req.user.role !== 'admin') {
            return res.status(403).json({ error: 'Admin access required' });
        }
        
        const quizId = req.params.id;
        const [result] = await pool.query('DELETE FROM quizzes WHERE id = ?', [quizId]);
        
        if (result.affectedRows === 0) {
            return res.status(404).json({ error: 'Quiz not found' });
        }
        
        res.json({ message: 'Quiz deleted successfully' });
    } catch (error) {
        console.error('Error deleting quiz:', error);
        res.status(500).json({ error: 'Server error' });
    }
});
