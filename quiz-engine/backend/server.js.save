        console.log(`   GET  http://localhost:${PORT}/api/quizzes/:id`);
        console.log(`   POST http://localhost:${PORT}/api/quizzes`);
        console.log(`   POST http://localhost:${PORT}/api/quizzes/:id/attempt`);
